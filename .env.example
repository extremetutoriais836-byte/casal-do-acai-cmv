# Modelo das variáveis de ambiente. COPIE para `.env.local` e preencha.
# `.env.local` NÃO é versionado (contém segredos) — veja .gitignore.

# --- Supabase (obrigatórias) ---------------------------------------------
# Painel do Supabase > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...          # pública por design (RLS protege os dados)

# SERVER-ONLY — bypassa a RLS. Só em lib/supabaseAdmin.ts (route handlers).
# NUNCA prefixar com NEXT_PUBLIC_. É um JWT longo, começa com "eyJ".
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Painel administrativo (/admin) --------------------------------------
# SERVER-ONLY. E-mails separados por vírgula.
ADMIN_EMAILS=voce@exemplo.com
